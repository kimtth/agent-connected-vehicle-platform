# ── AI Provider (choose one) ──────────────────────────────────────────
# Option A: Azure OpenAI with managed identity (key auth disabled)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Option B: Azure OpenAI with API key
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# Option C: OpenAI (non-Azure)
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ── Azure Speech ─────────────────────────────────────────────────────
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus2

# ── Cosmos DB ────────────────────────────────────────────────────────
# Managed identity (production / App Service)
COSMOS_DB_ENDPOINT=https://your-cosmosdb-account.documents.azure.com:443/
COSMOS_DB_USE_AAD=true

# Key auth (local emulator)
# COSMOS_DB_ENDPOINT=https://localhost:8081/
# COSMOS_DB_KEY=C2y6yDjf5...=
# COSMOS_DB_USE_AAD=false

COSMOS_DB_DATABASE=VehiclePlatformDB

# ── Azure AD Authentication ──────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-application-client-id
AZURE_AUTH_REQUIRED=true

# ── App Configuration ────────────────────────────────────────────────
ENABLE_MCP=true
MCP_SERVER_HOST=127.0.0.1
LOG_LEVEL=INFO

# Optional Azure OpenAI API key (managed identity remains the default above)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_NAME=

# Cosmos DB container names
COSMOS_DB_CONTAINER_VEHICLES=vehicles
COSMOS_DB_CONTAINER_SERVICES=services
COSMOS_DB_CONTAINER_COMMANDS=commands
COSMOS_DB_CONTAINER_NOTIFICATIONS=notifications
COSMOS_DB_CONTAINER_STATUS=vehiclestatus

# Audience MUST be the Application ID URI (Expose an API) NOT the raw GUID when using custom scopes
AZURE_AUTH_DEBUG=true

# Frontend will request scope: api://your-application-client-id-or-alias/access_as_user
API_TEST_MODE=true # Don’t use true in production. For development purposes only when facing an Entra ID issue.
